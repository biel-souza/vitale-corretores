# ⚠️ EXEMPLO - Não usar em produção!
# 
# Este arquivo mostra a estrutura do .env.docker
# Copie para .env.docker e altere os valores:
#
# cp .env.docker.example .env.docker
# nano .env.docker

# Porta da aplicação
PORT=3000

# Credenciais do banco de dados PostgreSQL EXTERNO
# IMPORTANTE: Configure com os dados do seu PostgreSQL existente
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario_postgresql
DB_PASSWORD=sua_senha_postgresql
DB_NAME=vitale_corretores

# Notas:
# - DB_HOST: IP ou hostname do servidor PostgreSQL
#   - Use 'localhost' se o PostgreSQL está no mesmo servidor
#   - Use o IP (ex: 192.168.1.100) se está em outro servidor
# - Crie o banco antes: CREATE DATABASE vitale_corretores;
# - A tabela será criada automaticamente na primeira execução

# Chatwoot API
CHATWOOT_API_URL=https://app.h-talks.com.br/api/v1
CHATWOOT_API_TOKEN=seu_token_api_chatwoot
CHATWOOT_BASE_URL=https://app.h-talks.com.br
# ID da inbox WhatsApp no Chatwoot usada para notificar os corretores
CHATWOOT_WHATSAPP_INBOX_ID=seu_inbox_id

# Nome do template aprovado no WhatsApp (enviado através do Chatwoot)
WHATSAPP_TEMPLATE_NAME=nome_do_template
