# Configuração Local (sem Docker)
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=vitale_corretores

# Chatwoot API
CHATWOOT_API_URL=https://app.h-talks.com.br/api/v1
CHATWOOT_API_TOKEN=seu_token_api_chatwoot
CHATWOOT_BASE_URL=https://app.h-talks.com.br
# ID da inbox WhatsApp no Chatwoot usada para notificar os corretores
CHATWOOT_WHATSAPP_INBOX_ID=seu_inbox_id

# Nome do template aprovado no WhatsApp (enviado através do Chatwoot)
WHATSAPP_TEMPLATE_NAME=nome_do_template
